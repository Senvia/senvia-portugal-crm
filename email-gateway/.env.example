# ── Senvia Email Gateway — environment ──────────────────────────────────────
# Copy to .env and fill in. NEVER commit .env (it is gitignored).

# Postgres connection (Supabase pooler). The gateway writes synced email here.
# Keep secret — it never reaches the browser.
DATABASE_URL=postgresql://postgres.chhmfwlimtbsyjmgtokn:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Shared secret the CRM Edge Functions use to call this gateway's action API.
GATEWAY_SHARED_SECRET=

# HTTP port the gateway listens on (action API). Runs ALONGSIDE Chatwoot — pick
# a free port; it does not touch Chatwoot.
PORT=8730

# ── Dev-only single-account test (src/imap-test.js) ─────────────────────────
# For the first connectivity proof, before wiring to the DB. In production the
# gateway reads credentials per-caixa from messaging_channels.metadata instead.
TEST_IMAP_HOST=imappro.zoho.eu
TEST_IMAP_PORT=993
TEST_IMAP_SECURE=true
TEST_IMAP_USER=geral@senvia.pt
TEST_IMAP_PASSWORD=
