{
  "manifest_version": 3,
  "name": "Senvia OS — WhatsApp",
  "version": "1.0.0",
  "description": "Traz o Senvia OS para dentro do WhatsApp Web: ficha do contacto ao lado da conversa e o CRM completo sem sair da pagina.",
  "minimum_chrome_version": "114",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chhmfwlimtbsyjmgtokn.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*",
        "https://app.senvia.pt/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "panel.html",
        "assets/*",
        "crm-app.html"
      ],
      "matches": [
        "https://web.whatsapp.com/*"
      ]
    }
  ],
  "action": {
    "default_title": "Senvia OS"
  }
}
